      },
      "name": "Call pipeline (draft + guardrail)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [520, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            { "value1": "={{ $json[\"status\"] }}", "operation": "equal", "value2": "APPROVED" }
