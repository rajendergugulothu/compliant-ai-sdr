      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1060, 200]
    },
    {
      "parameters": {},
      "name": "Escalate to human queue",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1060, 400]
    }
  ],
  "connections": {
    "Webhook: incoming lead": { "main": [[{ "node": "Call pipeline (draft + guardrail)", "type": "main", "index": 0 }]] },
    "Call pipeline (draft + guardrail)": { "main": [[{ "node": "IF approved", "type": "main", "index": 0 }]] },
    "IF approved": {
      "main": [
        [{ "node": "Send email (your provider)", "type": "main", "index": 0 }],
        [{ "node": "Escalate to human queue", "type": "main", "index": 0 }]
      ]
    }
  },
  "_comment": "Starter graph. Replace the two noOp nodes with your email provider and human-queue (Slack/ticket) nodes. Expose the repo's pipeline as an HTTP endpoint at /run-lead that runs guardrail_send on one lead and returns {status, subject, ...}."
